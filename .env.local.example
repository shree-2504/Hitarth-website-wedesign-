# Copy this file to .env.local and fill in your Sanity project details.
# Don't have a Sanity project yet? Run: npx sanity@latest init
# (choose "create new project", any dataset name — "production" is the default)
#
# Until these are filled in, the site automatically falls back to the
# hardcoded projects in /data/projects.ts — everything still works.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form (app/api/contact) — sends submissions via Resend.
# Get a free API key at https://resend.com after signing up.
# Until this is set, the form shows an error asking visitors to email directly.
RESEND_API_KEY=

# Where contact form submissions are sent. Defaults to we.designarc@gmail.com
# if left blank.
CONTACT_TO_EMAIL=we.designarc@gmail.com
